@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiFileProviderNative 0.6 CONFIG HINTS "$ENV{IIFILEPROVIDER_PREFIX}" "$ENV{HOME}/.local/SDK/iiFileProvider")


find_dependency(ICU 69 COMPONENTS i18n uc data)
find_dependency(SQLite3 3.37)
if(NOT TARGET SQLite3::SQLite3)
    add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
endif()
find_dependency(Threads)
if(@IICALENDAR_WITH_CURL@)
    find_dependency(CURL 7.85)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiCalendarTargets.cmake")

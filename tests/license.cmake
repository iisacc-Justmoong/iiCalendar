license_require("${SOURCE_ROOT}/ThirdParty/nlohmann/LICENSE.MIT" "Copyright (c) 2013-2025 Niels Lohmann")

# Install from a private copy of cmake_install.cmake. cmake --install --prefix
# still writes install_manifest.txt into the shared build tree, which races
# with iiCalendar.installed_consumer. Redirect those manifest paths the same
# way tests/installed_consumer.py does.
if(IS_SYMLINK "${BUILD_ROOT}" OR IS_SYMLINK "${BUILD_ROOT}/cmake_install.cmake")
    message(FATAL_ERROR "The license install must not cross a symlink")
endif()
set(stage "${BUILD_ROOT}/license-install-stage")
if(IS_SYMLINK "${stage}")
    message(FATAL_ERROR "The license install stage must be a direct directory")
endif()
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}")
set(prefix "${stage}/prefix")
file(TO_CMAKE_PATH "${BUILD_ROOT}" build_posix)
file(TO_CMAKE_PATH "${stage}" stage_posix)
file(READ "${BUILD_ROOT}/cmake_install.cmake" install_script)
set(install_script_isolated "${install_script}")
set(redirected 0)
foreach(manifest_name IN ITEMS
        "install_local_manifest.txt"
        "\${CMAKE_INSTALL_MANIFEST}")
    set(manifest_from "${build_posix}/${manifest_name}")
    set(manifest_to "${stage_posix}/${manifest_name}")
    string(REPLACE "${manifest_from}" "" manifest_stripped "${install_script_isolated}")
    string(LENGTH "${install_script_isolated}" manifest_before_len)
    string(LENGTH "${manifest_stripped}" manifest_after_len)
    string(LENGTH "${manifest_from}" manifest_from_len)
    math(EXPR manifest_occurrences "(${manifest_before_len} - ${manifest_after_len}) / ${manifest_from_len}")
    if(manifest_occurrences EQUAL 1)
        string(REPLACE "${manifest_from}" "${manifest_to}" install_script_isolated "${install_script_isolated}")
        math(EXPR redirected "${redirected} + 1")
    elseif(NOT manifest_occurrences EQUAL 0)
        message(FATAL_ERROR "Cannot safely redirect ${manifest_from}: found ${manifest_occurrences} times")
    endif()
endforeach()
if(redirected LESS 1)
    message(FATAL_ERROR "The generated install script has no manifest path to isolate")
endif()
foreach(manifest_name IN ITEMS
        "install_local_manifest.txt"
        "install_manifest.txt"
        "\${CMAKE_INSTALL_MANIFEST}")
    string(FIND "${install_script_isolated}" "${build_posix}/${manifest_name}" manifest_still)
    if(NOT manifest_still LESS 0)
        message(FATAL_ERROR "Isolated install script still writes ${manifest_name} into the shared build tree")
    endif()
endforeach()
set(shared_manifest "${BUILD_ROOT}/install_manifest.txt")
set(had_shared_manifest FALSE)
if(EXISTS "${shared_manifest}")
    file(READ "${shared_manifest}" shared_manifest_before)
    set(had_shared_manifest TRUE)
endif()
file(WRITE "${stage}/cmake_install.cmake" "${install_script_isolated}")
unset(ENV{DESTDIR})
set(install_command "${CMAKE_COMMAND}" -DCMAKE_INSTALL_LOCAL_ONLY=ON
    "-DCMAKE_INSTALL_PREFIX=${prefix}")
if(CONFIG_TYPE)
    list(APPEND install_command "-DCMAKE_INSTALL_CONFIG_NAME=${CONFIG_TYPE}")
endif()
list(APPEND install_command -P "${stage}/cmake_install.cmake")
execute_process(COMMAND ${install_command} RESULT_VARIABLE install_result)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "Isolated install did not copy the package license files")
endif()
if(had_shared_manifest)
    file(READ "${shared_manifest}" shared_manifest_after)
    if(NOT shared_manifest_before STREQUAL shared_manifest_after)
        message(FATAL_ERROR "The shared build installation manifest changed")
    endif()
elseif(EXISTS "${shared_manifest}")
    message(FATAL_ERROR "The shared build installation manifest was created")
endif()
if(NOT EXISTS "${stage}/install_manifest.txt")
    message(FATAL_ERROR "The isolated install did not write its own manifest")
endif()
set(data "${prefix}/${INSTALL_DATADIR}/iiCalendar")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
    "${SOURCE_ROOT}/LICENSE" "${data}/LICENSE" RESULT_VARIABLE installed_license)
if(NOT installed_license EQUAL 0)
    message(FATAL_ERROR "Installed LICENSE is not the Apache-2.0 text")
endif()
license_require("${data}/NOTICE" "Copyright (c) 2026 iisacc")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
    "${SOURCE_ROOT}/LICENSE" "${data}/licenses/iisacc-counterpart/LICENSE"
    RESULT_VARIABLE installed_counterpart)
if(NOT installed_counterpart EQUAL 0)
    message(FATAL_ERROR "Installed counterpart LICENSE is not the Apache-2.0 text")
endif()
license_require("${data}/licenses/iisacc-counterpart/NOTICE" "Copyright (c) 2026 iisacc")
license_require("${data}/licenses/nlohmann-json/LICENSE.MIT" "MIT License")
license_require("${data}/licenses/nlohmann-json/LICENSE.MIT" "Copyright (c) 2013-2025 Niels Lohmann")
license_require("${prefix}/${INSTALL_LIBDIR}/cmake/iiCalendar/iiCalendarConfig.cmake"
    "set(iiCalendar_SPDX_LICENSE \"Apache-2.0\")")

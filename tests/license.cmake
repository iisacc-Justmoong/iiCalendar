license_require("${SOURCE_ROOT}/NOTICE" "Copyright (c) 2026 iisacc")
license_require("${SOURCE_ROOT}/NOTICE" "Apache License")
license_require("${SOURCE_ROOT}/ThirdParty/licenses/iisacc-counterpart/NOTICE" "Copyright (c) 2026 iisacc")
license_require("${SOURCE_ROOT}/README.md" "SPDX-License-Identifier: Apache-2.0")
license_reject("${SOURCE_ROOT}/README.md" "SPDX-License-Identifier: MIT")
license_require("${SOURCE_ROOT}/docs/License.md" "SPDX-License-Identifier: Apache-2.0")
license_require("${SOURCE_ROOT}/docs/License.md" "Apache License 2.0")
license_require("${SOURCE_ROOT}/AGENT.md" "Apache License 2.0")

if(NOT SOURCE_ROOT OR NOT BUILD_ROOT OR NOT PACKAGE_CONFIG OR NOT INSTALL_LIBDIR OR NOT INSTALL_DATADIR)
    message(FATAL_ERROR "SOURCE_ROOT, BUILD_ROOT, PACKAGE_CONFIG, INSTALL_LIBDIR and INSTALL_DATADIR are required")
endif()

function(license_require path needle)
    file(READ "${path}" text)
    string(FIND "${text}" "${needle}" at)
    if(at LESS 0)
        message(FATAL_ERROR "${path} does not contain: ${needle}")
    endif()
endfunction()

function(license_reject path needle)
    file(READ "${path}" text)
    string(FIND "${text}" "${needle}" at)
    if(NOT at LESS 0)
        message(FATAL_ERROR "${path} still contains: ${needle}")
    endif()
endfunction()

license_require("${SOURCE_ROOT}/LICENSE" "Apache License")
license_require("${SOURCE_ROOT}/LICENSE" "Version 2.0, January 2004")
license_require("${SOURCE_ROOT}/LICENSE" "END OF TERMS AND CONDITIONS")
license_require("${SOURCE_ROOT}/LICENSE" "http://www.apache.org/licenses/LICENSE-2.0")
license_reject("${SOURCE_ROOT}/LICENSE" "Permission is hereby granted")
license_reject("${SOURCE_ROOT}/LICENSE" "MIT License")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
    "${SOURCE_ROOT}/LICENSE"
    "${SOURCE_ROOT}/ThirdParty/licenses/iisacc-counterpart/LICENSE"
    RESULT_VARIABLE counterpart_same)
if(NOT counterpart_same EQUAL 0)
    message(FATAL_ERROR "The first-party counterpart LICENSE is not the Apache-2.0 text")
endif()
license_require("${SOURCE_ROOT}/NOTICE" "Copyright (c) 2026 iisacc")
license_require("${SOURCE_ROOT}/NOTICE" "Apache License")
license_require("${SOURCE_ROOT}/ThirdParty/licenses/iisacc-counterpart/NOTICE" "Copyright (c) 2026 iisacc")
license_require("${SOURCE_ROOT}/README.md" "SPDX-License-Identifier: Apache-2.0")
license_reject("${SOURCE_ROOT}/README.md" "SPDX-License-Identifier: MIT")
license_require("${SOURCE_ROOT}/docs/License.md" "SPDX-License-Identifier: Apache-2.0")
license_require("${SOURCE_ROOT}/docs/License.md" "Apache License 2.0")
license_require("${SOURCE_ROOT}/AGENT.md" "Apache License 2.0")
license_require("${SOURCE_ROOT}/src/Security/Sha256.cpp" "Apache-2.0")
license_reject("${SOURCE_ROOT}/src/Security/Sha256.cpp" "MIT")
license_require("${PACKAGE_CONFIG}" "set(iiCalendar_SPDX_LICENSE \"Apache-2.0\")")
license_require("${SOURCE_ROOT}/ThirdParty/nlohmann/LICENSE.MIT" "MIT License")
license_require("${SOURCE_ROOT}/ThirdParty/nlohmann/LICENSE.MIT" "Copyright (c) 2013-2025 Niels Lohmann")

set(prefix "${BUILD_ROOT}/license-install-prefix")
set(install_command "${CMAKE_COMMAND}" --install "${BUILD_ROOT}" --prefix "${prefix}")
if(CONFIG_TYPE)
    list(APPEND install_command --config "${CONFIG_TYPE}")
endif()
execute_process(COMMAND ${install_command} RESULT_VARIABLE install_result)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "cmake --install did not copy the package license files")
endif()
set(data "${prefix}/${INSTALL_DATADIR}/iiCalendar")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
    "${SOURCE_ROOT}/LICENSE" "${data}/LICENSE" RESULT_VARIABLE installed_license)
if(NOT installed_license EQUAL 0)
    message(FATAL_ERROR "Installed LICENSE is not the Apache-2.0 text")
endif()
license_require("${data}/NOTICE" "Copyright (c) 2026 iisacc")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
    "${SOURCE_ROOT}/LICENSE" "${data}/licenses/iisacc-counterpart/LICENSE"
    RESULT_VARIABLE installed_counterpart)
if(NOT installed_counterpart EQUAL 0)
    message(FATAL_ERROR "Installed counterpart LICENSE is not the Apache-2.0 text")
endif()
license_require("${data}/licenses/iisacc-counterpart/NOTICE" "Copyright (c) 2026 iisacc")
license_require("${data}/licenses/nlohmann-json/LICENSE.MIT" "MIT License")
license_require("${data}/licenses/nlohmann-json/LICENSE.MIT" "Copyright (c) 2013-2025 Niels Lohmann")
license_require("${prefix}/${INSTALL_LIBDIR}/cmake/iiCalendar/iiCalendarConfig.cmake"
    "set(iiCalendar_SPDX_LICENSE \"Apache-2.0\")")

execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
    "${SOURCE_ROOT}/LICENSE"
    "${SOURCE_ROOT}/ThirdParty/licenses/iisacc-counterpart/LICENSE"
    RESULT_VARIABLE counterpart_same)
if(NOT counterpart_same EQUAL 0)

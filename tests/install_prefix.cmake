if(NOT HELPER OR NOT EXPECTED)
    message(FATAL_ERROR "HELPER and EXPECTED are required")
endif()
set(PROJECT_IS_TOP_LEVEL TRUE)
set(CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT TRUE)
include("${HELPER}")
calendar_set_install_prefix()
if(NOT CMAKE_INSTALL_PREFIX STREQUAL EXPECTED)
    message(FATAL_ERROR "Unexpected default installation prefix")
endif()
set(CMAKE_INSTALL_PREFIX "explicit-prefix" CACHE PATH "" FORCE)
set(CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT FALSE)
calendar_set_install_prefix()
if(NOT CMAKE_INSTALL_PREFIX STREQUAL "explicit-prefix")
    message(FATAL_ERROR "Explicit installation prefix was overwritten")
endif()
